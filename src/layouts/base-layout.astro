---
import "../styles/tokens.css";
import "../styles/global.css";
import Panel from "../components/panel.astro";
import StatusBar from "../components/status-bar.astro";
import fontRegularUrl from "../assets/fonts/pixelify-sans-latin-400-normal.woff2?url";
import { plainContentId } from "../shell/desktop-model";

interface Props {
  title: string;
}
const { title } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <link rel="preload" href={fontRegularUrl} as="font" type="font/woff2" crossorigin />
  </head>
  <body>
    <a class="skip-link" href="#main">
      Skip to main content
    </a>
    <a class="skip-link" href={`#${plainContentId}`}>
      Skip the desktop to plain content
    </a>
    <slot />
    <footer>
      <StatusBar fields={["Placeholder content only. Real content arrives in a later milestone."]}>
        <Panel variant="sunken" class="field">
          Open licences:
          <a href="/licenses/pixelify-sans-OFL.txt">Pixelify Sans (OFL)</a>,
          <a href="/licenses/pixelarticons-MIT.txt">pixelarticons (MIT)</a>
        </Panel>
      </StatusBar>
    </footer>
  </body>
</html>

<style is:global>
  .skip-link {
    position: absolute;
    left: var(--space-2);
    top: -6rem;
    padding: var(--space-2) var(--space-4);
    background: var(--color-window-face);
    color: var(--color-window-text);
    border: 2px solid var(--color-window-frame);
    box-shadow: var(--bevel-raised);
    z-index: 1;
  }
  .skip-link:focus {
    top: var(--space-2);
  }
  /* The ring sits outside the link, on the bare desktop. */
  .skip-link:focus-visible {
    outline-color: var(--color-focus-ring-on-desktop);
  }
</style>
