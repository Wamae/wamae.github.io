---
import Window from "../components/window.astro";

// What the desktop shows before any section is open. Its title is the page's h1: the owner name.
interface Props {
  ownerName: string;
}
const { ownerName } = Astro.props;
---

<div class="welcome">
  <Window id="welcome" title={ownerName} headingLevel={1} landmark={false} active>
    <p>Welcome. The content on this site is placeholder text for now.</p>
    <p>Open a folder on the desktop, or use the Start menu, to see a section.</p>
  </Window>
</div>

<style>
  .welcome {
    max-width: 32rem;
  }
</style>
