---
import Button from "../components/button.astro";
import Window from "../components/window.astro";
import { contentSections, plainContentId } from "./desktop-model";
---

<div id={plainContentId} class="content-windows">
  {contentSections.map((section) => (
    <Window id={section.id} title={section.title}>
      <p>{section.placeholder}</p>
      <p class="back">
        <Button href="#program-manager">Back to Program Manager</Button>
      </p>
    </Window>
  ))}
</div>

<style>
  .content-windows {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: var(--space-4);
  }
  /* Two by two, so the fourth window is never alone on a row. Stacked on phones. */
  @media (min-width: 40rem) {
    .content-windows {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  .back {
    margin-top: var(--space-4);
  }
</style>
