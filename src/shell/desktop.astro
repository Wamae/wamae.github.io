---
import DesktopIcon from "../components/desktop-icon.astro";
import { desktopIcons } from "./section-model";
---

<div class="desktop">
  <nav aria-label="Desktop folders">
    <ul class="icons">
      {desktopIcons.map((icon) => (
        <li>
          <DesktopIcon label={icon.label} href={icon.href} icon={icon.icon} />
        </li>
      ))}
    </ul>
  </nav>
  <div class="stage" data-swap="stage">
    <slot />
  </div>
</div>

<style>
  /* The desktop takes the height between the top of the page and the status bar. The page itself
     does not grow with a window's content: windows scroll inside. A desktop too short for its
     contents scrolls as a last resort. */
  .desktop {
    position: relative;
    flex: 1 1 0;
    min-height: 0;
    overflow: auto;
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    grid-template-rows: minmax(0, 1fr);
    gap: var(--space-2);
    padding: var(--space-2);
  }
  .icons {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    padding: 0;
    list-style: none;
  }
  /* On the bare desktop (no browser window) the ring around the page sits on the desktop colour. */
  .stage > :global(main:focus-visible) {
    outline-color: var(--color-focus-ring-on-desktop);
  }
  .stage {
    min-height: 0;
    display: flex;
    flex-direction: column;
    min-width: 0;
  }
  /* On a phone the icons take their own height and the window takes the rest. */
  @media (max-width: 39.99rem) {
    .desktop {
      grid-template-rows: auto minmax(0, 1fr);
    }
    .icons {
      flex-wrap: nowrap;
      gap: var(--space-1);
    }
    .icons li {
      flex: 1 1 0;
      min-width: 0;
    }
  }
  @media (min-width: 40rem) {
    .desktop {
      grid-template-columns: 8rem minmax(0, 1fr);
      gap: var(--space-4);
      padding: var(--space-4);
    }
    .icons {
      align-self: start;
      flex-direction: column;
      flex-wrap: nowrap;
    }
  }
  /* A maximized window sits over the desktop, so the desktop must not scroll it out of place. */
  @media (min-width: 40rem) {
    .desktop:has(:global(.browser[data-maximized]:not([hidden]))) {
      overflow: hidden;
    }
  }
  /* A short screen: the page scrolls, not the desktop, and the rows take the height they need. */
  @media (max-height: 30rem) {
    .desktop {
      flex: 1 0 auto;
      overflow: visible;
      grid-template-rows: none;
    }
    .stage {
      min-height: auto;
    }
  }
</style>
