---
import DesktopLayout from "../layouts/desktop-layout.astro";
import SectionContent from "../shell/section-content.astro";
import { contentSections } from "../shell/section-model";
import ExperienceView from "../content/views/experience-view.astro";
import { getProfile } from "../content";

const section = contentSections.find((candidate) => candidate.id === "experience");
if (section === undefined) throw new Error("Missing section: experience");
---

<DesktopLayout section={section}>
  <SectionContent section={section}>
    <ExperienceView profile={getProfile()} />
  </SectionContent>
</DesktopLayout>
