---
// A box with a raised or sunken 3D border. Pure presentation, so any element can be chosen.
interface Props {
  variant: "raised" | "sunken";
  as?: "div" | "section" | "li";
  class?: string;
}
const { variant, as: Tag = "div", class: className } = Astro.props;
---

<Tag class:list={["panel", variant, className]}>
  <slot />
</Tag>

<style>
  .panel {
    background: var(--color-window-face);
    color: var(--color-window-text);
    padding: var(--space-1) var(--space-2);
  }
  .raised {
    box-shadow: var(--bevel-raised);
  }
  .sunken {
    box-shadow: var(--bevel-sunken);
  }
</style>
