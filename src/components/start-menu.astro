---
import Icon from "./icon.astro";
import type { LinkGroup } from "../shell/section-model";

// The Start menu. A native disclosure (<details>) holding a navigation of real links, so it
// opens, closes and navigates without JavaScript. The script only adds arrow keys, Escape,
// outside click and focus return. The Screen Saver item is a button that only the script reveals,
// and only while animations are on (the saver never runs for visitors who asked for less motion).
interface Props {
  groups: readonly LinkGroup[];
}
const { groups } = Astro.props;
---

<details class="start" data-start-menu>
  <summary class="start-button" id="start-button">
    <Icon name="monitor" />
    Start
  </summary>
  <nav class="start-panel" aria-label="Start menu">
    {groups.map((group) => (
      <div class="group">
        <p class="group-label" id={`start-group-${group.id}`}>
          {group.label}
        </p>
        <ul aria-labelledby={`start-group-${group.id}`}>
          {group.items.map((item) => (
            <li>
              <a class="start-item" href={item.href}>
                <Icon name={item.icon} />
                {item.label}
              </a>
            </li>
          ))}
          {group.id === "desktop" && (
            <li data-audience="script" data-needs-animations>
              <button class="start-item" type="button" data-screensaver-start>
                <Icon name="monitor" />
                Screen Saver
              </button>
            </li>
          )}
        </ul>
      </div>
    ))}
  </nav>
</details>

<style>
  .start {
    position: relative;
    flex: none;
  }
  .start-button {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    min-height: 2.25rem;
    padding: 0 var(--space-3);
    background: var(--color-start-button-bg);
    color: var(--color-start-button-text);
    border: 1px solid var(--color-window-frame);
    box-shadow: var(--bevel-raised);
    font-weight: 700;
    list-style: none;
    cursor: pointer;
    -webkit-tap-highlight-color: transparent;
  }
  .start-button::-webkit-details-marker {
    display: none;
  }
  @media (max-width: 29.99rem) {
    .start-button {
      gap: var(--space-1);
      padding: 0 var(--space-2);
    }
  }
  .start[open] > .start-button {
    box-shadow: var(--bevel-sunken);
  }
  .start-panel {
    position: absolute;
    bottom: 100%;
    left: 0;
    z-index: 20;
    width: 16rem;
    max-width: calc(100vw - var(--space-2));
    /* On a short screen the menu scrolls instead of running off the top. */
    max-height: calc(100vh - var(--taskbar-height));
    max-height: calc(100dvh - var(--taskbar-height));
    overflow-y: auto;
    padding: var(--space-1);
    background: var(--color-start-menu-bg);
    color: var(--color-start-menu-text);
    border: 1px solid var(--color-window-frame);
    box-shadow: var(--bevel-raised);
  }
  .group + .group {
    margin-top: var(--space-1);
    padding-top: var(--space-1);
    border-top: 1px solid var(--color-window-frame);
  }
  .group-label {
    padding: 0 var(--space-2);
    font-weight: 700;
  }
  ul {
    padding: 0;
    list-style: none;
  }
  /* Script-only items: not there without the script, and not there while animations are off. */
  li[data-audience="script"] {
    display: none;
  }
  :global(.js) li[data-audience="script"]:not([hidden]) {
    display: block;
  }
  .start-item {
    display: flex;
    width: 100%;
    background: var(--color-start-menu-bg);
    border: 0;
    font: inherit;
    text-align: left;
    cursor: pointer;
    align-items: center;
    gap: var(--space-2);
    min-height: 2.25rem;
    padding: 0 var(--space-2);
    color: var(--color-start-menu-text);
    text-decoration: none;
  }
  .start-item:hover {
    background: var(--color-selection-bg);
    color: var(--color-selection-text);
  }
  /* A focused item is drawn selected, with the ring inside it. */
  .start-item:focus-visible {
    background: var(--color-selection-bg);
    color: var(--color-selection-text);
    outline-color: var(--color-focus-ring-on-selection);
    outline-offset: -2px;
  }
</style>
