---
// A window: frame, title bar, optional menu bar and status bar, and a client area.
// The title is a real heading, so it names the window. Real title bar controls come in through
// the "controls" slot; a window without them (the welcome window, the programs inside the
// browser window) shows none, so nothing looks clickable and is dead.
interface Props {
  id: string;
  title: string;
  /** The title is a heading of this level, or plain text when `null` (a title that is only chrome). */
  headingLevel?: 1 | 2 | 3 | null;
  active?: boolean;
  /** True for a top-level region landmark, false for a window nested in another. */
  landmark?: boolean;
  class?: string;
  /** The client area scrolls inside the window and is a named region a keyboard can focus. */
  scrollable?: boolean;
  /** The name of the scrollable region. */
  clientLabel?: string;
}
const {
  id,
  title,
  headingLevel = 2,
  active = false,
  landmark = true,
  class: className,
  scrollable = false,
  clientLabel,
} = Astro.props;
const Frame = landmark ? "section" : "div";
const Heading = headingLevel === null ? "span" : (`h${headingLevel}` as const);
const titleId = `${id}-title`;
const hasMenu = Astro.slots.has("menu");
const hasToolbar = Astro.slots.has("toolbar");
const hasControls = Astro.slots.has("controls");
const hasStatus = Astro.slots.has("status");
---

<Frame
  class:list={["window", { active }, className]}
  id={id}
  aria-labelledby={titleId}
  role={landmark ? undefined : "group"}
>
  <div class="titlebar">
    <Heading class="title" id={titleId}>
      {title}
    </Heading>
    {hasControls && (
      <span class="controls">
        <slot name="controls" />
      </span>
    )}
  </div>
  {hasMenu && <slot name="menu" />}
  {hasToolbar && <slot name="toolbar" />}
  <div
    class:list={["client", { "nt-scroll": scrollable }]}
    role={scrollable ? "group" : undefined}
    tabindex={scrollable ? 0 : undefined}
    aria-label={scrollable ? (clientLabel ?? title) : undefined}
    data-scroll-client={scrollable ? "" : undefined}
  >
    <slot />
  </div>
  {hasStatus && <slot name="status" />}
</Frame>

<style>
  .window {
    min-width: 0;
    background: var(--color-window-face);
    color: var(--color-window-text);
    border: 1px solid var(--color-window-frame);
    box-shadow: var(--bevel-raised);
    padding: 2px;
    display: flex;
    flex-direction: column;
  }
  .client {
    flex: 1 1 auto;
    min-height: 0;
    min-width: 0;
  }
  .titlebar {
    display: flex;
    align-items: stretch;
    gap: 2px;
    background: var(--color-title-inactive-bg);
    color: var(--color-title-inactive-text);
    border: 1px solid var(--color-window-frame);
    /* A double click on the title bar maximizes, and must not select the title. */
    user-select: none;
  }
  .active > .titlebar {
    background: var(--color-title-active-bg);
    color: var(--color-title-active-text);
  }
  .title {
    flex: 1 1 auto;
    min-width: 0;
    /* A long title is cut with an ellipsis. The element keeps its full text, so assistive technology reads all of it. */
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    padding: 0 var(--space-2);
    font-size: var(--font-size-ui);
    font-weight: 700;
    line-height: 1.75rem;
    text-align: center;
  }
  .controls {
    display: flex;
    flex: none;
    gap: 2px;
  }
  /* A class that sets display would otherwise beat the hidden attribute. */
  .window[hidden] {
    display: none;
  }
  .client {
    background: var(--color-client-bg);
    color: var(--color-client-text);
    border: 1px solid var(--color-window-frame);
    box-shadow: var(--bevel-sunken);
    padding: var(--space-3);
  }
  /* The ring is drawn inside the area, where the client's own colour is behind it. */
  .client:focus-visible {
    background: var(--color-client-bg);
    outline-color: var(--color-focus-ring);
    outline-offset: -4px;
  }
  /* On a short screen the window is as tall as its content, and the page scrolls. */
  @media (max-height: 30rem) {
    .client.nt-scroll {
      flex: none;
    }
  }
</style>
