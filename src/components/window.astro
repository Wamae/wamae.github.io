---
// A window: frame, title bar, optional menu bar and status bar, and a client area.
// The title is a real heading, so it names the window. The control box and the
// minimise and maximise buttons are decorative until the window manager exists.
interface Props {
  id: string;
  title: string;
  headingLevel?: 2 | 3;
  active?: boolean;
  /** True for a top-level region landmark, false for a window nested in another. */
  landmark?: boolean;
}
const { id, title, headingLevel = 2, active = false, landmark = true } = Astro.props;
const Frame = landmark ? "section" : "div";
const Heading = `h${headingLevel}` as const;
const titleId = `${id}-title`;
const hasMenu = Astro.slots.has("menu");
const hasStatus = Astro.slots.has("status");
---

<Frame
  class:list={["window", { active }]}
  id={id}
  aria-labelledby={titleId}
  role={landmark ? undefined : "group"}
>
  <div class="titlebar">
    <span class="control-box" aria-hidden="true"></span>
    <Heading class="title" id={titleId}>
      {title}
    </Heading>
    <span class="controls" aria-hidden="true">
      <span class="control minimise"></span>
      <span class="control maximise"></span>
    </span>
  </div>
  {hasMenu && <slot name="menu" />}
  <div class="client">
    <slot />
  </div>
  {hasStatus && <slot name="status" />}
</Frame>

<style>
  .window {
    min-width: 0;
    background: var(--color-window-face);
    color: var(--color-window-text);
    border: 1px solid var(--color-window-frame);
    box-shadow: var(--bevel-raised);
    padding: 2px;
    display: flex;
    flex-direction: column;
  }
  .client {
    flex: 1 1 auto;
  }
  .titlebar {
    display: flex;
    align-items: stretch;
    gap: 2px;
    background: var(--color-title-inactive-bg);
    color: var(--color-title-inactive-text);
    border: 1px solid var(--color-window-frame);
  }
  .active > .titlebar {
    background: var(--color-title-active-bg);
    color: var(--color-title-active-text);
  }
  .title {
    flex: 1 1 auto;
    min-width: 0;
    padding: 0 var(--space-2);
    font-size: var(--font-size-ui);
    font-weight: 700;
    line-height: 1.75rem;
    text-align: center;
  }
  .control-box,
  .control {
    position: relative;
    flex: none;
    width: 1.75rem;
    background: var(--color-button-face);
    color: var(--color-button-text);
    box-shadow: var(--bevel-raised);
  }
  .controls {
    display: flex;
    gap: 2px;
  }
  .control-box::before {
    content: "";
    position: absolute;
    left: 25%;
    right: 25%;
    top: calc(50% - 1px);
    height: 3px;
    background: currentColor;
  }
  .control::before {
    content: "";
    position: absolute;
    inset: 30%;
    background: currentColor;
  }
  .minimise::before {
    clip-path: polygon(0 20%, 100% 20%, 50% 80%);
  }
  .maximise::before {
    clip-path: polygon(50% 20%, 100% 80%, 0 80%);
  }
  .client {
    background: var(--color-client-bg);
    color: var(--color-client-text);
    border: 1px solid var(--color-window-frame);
    box-shadow: var(--bevel-sunken);
    padding: var(--space-3);
  }
</style>
