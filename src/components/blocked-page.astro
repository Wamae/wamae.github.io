---
import Button from "./button.astro";
import Panel from "./panel.astro";

// Shown in the browser window instead of a frame when a site is known to refuse being shown inside
// another page. It says so plainly and gives the visitor the address and a button to open it in a
// new tab. Nothing leaves this site unless the visitor presses that button.
interface Props {
  url: string;
  label: string;
}
const { url, label } = Astro.props;
---

<div class="blocked">
  <Panel variant="raised" class="dialog">
    <h2>This page cannot be displayed in this window</h2>
    <p>
      {label} does not allow other sites to show its pages inside a window. This is a rule of that
      site, not a fault here.
    </p>
    <p>Address:</p>
    <Panel variant="sunken" class="address-text">
      {url}
    </Panel>
    <p>
      <Button href={url} newTab>
        Open in a new tab<span class="visually-hidden"> ({label}, leaves this site)</span>
      </Button>
    </p>
  </Panel>
</div>

<style>
  .blocked :global(.dialog) {
    display: grid;
    gap: var(--space-3);
    max-width: 40rem;
    padding: var(--space-4);
  }
  h2 {
    font-size: 1.25rem;
    line-height: 1.3;
  }
  .blocked :global(.address-text) {
    font-size: 0.875rem;
    overflow-wrap: anywhere;
  }
</style>
