---
// Draws one of the self-hosted pixelarticons (MIT) inline, so it takes its colour from the text.
// Decorative: the link or button around it carries the accessible name.
import type { IconName } from "./icon-names";

const icons = import.meta.glob<string>("../assets/icons/*.svg", {
  query: "?raw",
  import: "default",
  eager: true,
});

interface Props {
  name: IconName;
}
const { name } = Astro.props;
const svg = icons[`../assets/icons/${name}.svg`];
if (svg === undefined) throw new Error(`Unknown icon: ${name}`);
---

<span class="icon" aria-hidden="true" set:html={svg} />

<style>
  .icon {
    display: inline-block;
    width: 1em;
    height: 1em;
    flex: none;
    line-height: 0;
  }
  .icon :global(svg) {
    width: 100%;
    height: 100%;
    shape-rendering: crispEdges;
  }
</style>
