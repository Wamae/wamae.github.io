---
// A row of menu titles. Dropdowns need JavaScript and arrive with the window manager,
// so for now the bar is decorative and hidden from assistive technology.
interface Props {
  items: readonly string[];
}
const { items } = Astro.props;
---

<ul class="menu-bar" aria-hidden="true">
  {items.map((item) => (
    <li>
      <u>{item.charAt(0)}</u>
      {item.slice(1)}
    </li>
  ))}
</ul>

<style>
  .menu-bar {
    display: flex;
    flex-wrap: wrap;
    gap: 0 var(--space-3);
    list-style: none;
    padding: 0 var(--space-2);
    background: var(--color-menu-bg);
    color: var(--color-menu-text);
    border-bottom: 1px solid var(--color-window-frame);
  }
</style>
