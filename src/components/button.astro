---
// A push button. With `href` it is a real link, otherwise a real button.
interface Props {
  href?: string;
  type?: "button" | "submit";
  id?: string;
  disabled?: boolean;
}
const { href, type = "button", id, disabled = false } = Astro.props;
---

{href !== undefined ? (
  <a class="button" href={href} id={id}>
    <slot />
  </a>
) : (
  <button class="button" type={type} id={id} disabled={disabled}>
    <slot />
  </button>
)}

<style>
  .button {
    display: inline-block;
    min-height: 2rem;
    padding: var(--space-1) var(--space-4);
    background: var(--color-button-face);
    color: var(--color-button-text);
    border: 1px solid var(--color-window-frame);
    box-shadow: var(--bevel-raised);
    font: inherit;
    font-weight: 700;
    text-align: center;
    text-decoration: none;
    cursor: pointer;
  }
  /* An etched look: dark gray text with a white offset shadow. Not a pair for live text. */
  .button:disabled {
    background: var(--color-button-face);
    color: var(--color-button-disabled-text);
    text-shadow: 1px 1px 0 var(--color-bevel-highlight);
    cursor: not-allowed;
  }
  .button:active:not(:disabled) {
    box-shadow: var(--bevel-sunken);
  }
  .button:focus-visible {
    outline-offset: -6px;
  }
</style>
