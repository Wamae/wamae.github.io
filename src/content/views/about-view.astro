---
import type { Profile } from "..";
import type { LinkRoute } from "../link-routes";
import RichText from "./rich-text.astro";

// About Me: the summary, key skills, education and certifications. A certification with a public
// link goes to its own page, which shows it inside the browser window instead of leaving the site.
interface Props {
  profile: Profile;
  routes: readonly LinkRoute[];
}
const { profile, routes } = Astro.props;
const pageOf = (url: string) => routes.find((route) => route.url === url)?.path;
---

<p class="headline">{profile.headline}</p>
{profile.summary.map((paragraph) => (
  <p>
    <RichText text={paragraph} />
  </p>
))}

<section aria-labelledby="skills-title">
  <h2 id="skills-title">Key skills</h2>
  <ul>
    {profile.keySkills.map((skill) => (
      <li>{skill}</li>
    ))}
  </ul>
</section>

<section aria-labelledby="education-title">
  <h2 id="education-title">Education</h2>
  <ul>
    {profile.education.map((entry) => (
      <li>
        <span class="institution">{entry.institution}</span>
        <br />
        {entry.qualification}
      </li>
    ))}
  </ul>
</section>

<section aria-labelledby="certifications-title">
  <h2 id="certifications-title">Certifications</h2>
  <ul>
    {profile.certifications.map((certification) => (
      <li>
        {certification.url === undefined || pageOf(certification.url) === undefined ? (
          certification.name
        ) : (
          <a href={pageOf(certification.url)}>{certification.name}</a>
        )}
      </li>
    ))}
  </ul>
</section>

<style>
  .institution {
    font-weight: 700;
  }
  .headline {
    font-weight: 700;
    font-size: 1.25rem;
  }
  section {
    display: grid;
    gap: var(--space-2);
  }
  h2 {
    font-size: 1.25rem;
  }
  ul {
    padding-left: var(--space-4);
    display: grid;
    gap: var(--space-1);
  }
</style>
