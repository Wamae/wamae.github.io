---
import type { ProfileLink } from "..";
import { linkTarget, type LinkRoute } from "../link-routes";

// Contact: the email from the site configuration, and the public profile links. A site that can be
// shown in the browser window opens there. A site that refuses to be shown there opens in a new tab.
interface Props {
  email: string;
  links: readonly ProfileLink[];
  routes: readonly LinkRoute[];
}
const { email, links, routes } = Astro.props;
const targetOf = (url: string) => linkTarget(routes, url);
---

<p>
  Email: <a href={`mailto:${email}`}>{email}</a>
</p>

<section aria-labelledby="links-title">
  <h2 id="links-title">Elsewhere online</h2>
  <ul>
    {links.map((link) => (
      <li>
        {targetOf(link.url) === undefined ? (
          link.label
        ) : (
          <a
            href={targetOf(link.url)?.href}
            target={targetOf(link.url)?.newTab ? "_blank" : undefined}
            rel={targetOf(link.url)?.newTab ? "noopener noreferrer" : undefined}
          >
            {link.label}
          </a>
        )}
      </li>
    ))}
  </ul>
</section>

<style>
  section {
    display: grid;
    gap: var(--space-2);
  }
  h2 {
    font-size: 1.25rem;
  }
  ul {
    padding-left: var(--space-4);
    display: grid;
    gap: var(--space-1);
  }
</style>
