---
import type { ProfileLink } from "..";
import type { LinkRoute } from "../link-routes";

// Contact: the email from the site configuration, and the public profile links. Each profile link
// goes to its own page, which shows it inside the browser window instead of leaving the site.
interface Props {
  email: string;
  links: readonly ProfileLink[];
  routes: readonly LinkRoute[];
}
const { email, links, routes } = Astro.props;
const pageOf = (url: string) => routes.find((route) => route.url === url)?.path;
---

<p>
  Email: <a href={`mailto:${email}`}>{email}</a>
</p>

<section aria-labelledby="links-title">
  <h2 id="links-title">Elsewhere online</h2>
  <ul>
    {links.map((link) => (
      <li>
        {pageOf(link.url) === undefined ? link.label : <a href={pageOf(link.url)}>{link.label}</a>}
      </li>
    ))}
  </ul>
</section>

<style>
  section {
    display: grid;
    gap: var(--space-2);
  }
  h2 {
    font-size: 1.25rem;
  }
  ul {
    padding-left: var(--space-4);
    display: grid;
    gap: var(--space-1);
  }
</style>
